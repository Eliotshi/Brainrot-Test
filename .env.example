# Supabase (Project Settings → API Keys). La clé publishable suffit : les tables
# sont fermées et tout passe par les fonctions public.cc_* (supabase/migrations).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Jeton serveur aléatoire pour les fonctions du CRM. Son hash SHA-256 est stocké
# dans private.app_config (clé admin_token_sha256).
ADMIN_RPC_TOKEN=une-longue-chaine-aleatoire
# Mot de passe du CRM /admin (12 caractères minimum)
ADMIN_PASSWORD=change-me-please-123
# Envoi du rapport par e-mail (Gmail). GMAIL_APP_PASSWORD = mot de passe
# d'application Google (myaccount.google.com/apppasswords, 2FA requise),
# PAS le mot de passe du compte. Sans ces deux variables, aucun e-mail ne part.
GMAIL_USER=brainrotaibis@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM_NAME=Cerveau Cramé
# URL publique du site (liens dans l'e-mail, lien de désinscription)
SITE_URL=https://ton-site.vercel.app
# Optionnel : clé de signature des liens de désinscription (à défaut, ADMIN_RPC_TOKEN)
# UNSUBSCRIBE_SECRET=une-autre-longue-chaine-aleatoire
