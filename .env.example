# Supabase (Project Settings → API Keys). La clé publishable suffit : les tables
# sont fermées et tout passe par les fonctions public.cc_* (supabase/migrations).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Jeton serveur aléatoire pour les fonctions du CRM. Son hash SHA-256 est stocké
# dans private.app_config (clé admin_token_sha256).
ADMIN_RPC_TOKEN=une-longue-chaine-aleatoire
# Mot de passe du CRM /admin (12 caractères minimum)
ADMIN_PASSWORD=change-me-please-123
